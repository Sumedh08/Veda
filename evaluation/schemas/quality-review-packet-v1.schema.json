{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veda.local/schemas/quality-review-packet-v1.schema.json",
  "title": "Veda independent research quality review packet",
  "description": "Two independent human reviews and a preserved adjudicated label set for one immutable report. Schema validity does not authenticate reviewers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "fixture_only", "dataset_id", "dataset_version",
    "evaluation_date", "case_id", "run", "reference_study_ids", "material_claim_ids",
    "appraisal_field_ids", "independent_reviews", "adjudication"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "packet_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "fixture_only": {"type": "boolean"},
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "dataset_version": {"type": "string", "minLength": 1, "maxLength": 120},
    "evaluation_date": {"type": "string", "format": "date"},
    "case_id": {"type": "string", "pattern": "^[A-Z]{3}[0-9]{2}$"},
    "run": {"$ref": "#/$defs/run"},
    "reference_study_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "material_claim_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "appraisal_field_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "independent_reviews": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"$ref": "#/$defs/review"}
    },
    "adjudication": {"$ref": "#/$defs/adjudication"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 200},
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["job_id", "report_id", "run_manifest_sha256", "retrieved_study_ids", "selected_study_ids", "full_text_access", "model_and_cost_recording"],
      "properties": {
        "job_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "report_id": {"type": "string", "minLength": 1, "maxLength": 200},
        "run_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "retrieved_study_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "selected_study_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "full_text_access": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["study_id", "usable_full_text", "usable_methods_results"],
            "properties": {
              "study_id": {"$ref": "#/$defs/id"},
              "usable_full_text": {"type": "boolean"},
              "usable_methods_results": {"type": "boolean"}
            }
          }
        },
        "model_and_cost_recording": {"type": "string", "minLength": 1, "maxLength": 2000}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["reviewer_pseudonym", "role", "expertise_area", "conflict_declared", "completed_date", "study_judgments", "claim_judgments", "appraisal_judgments", "abstention_judgment"],
      "properties": {
        "reviewer_pseudonym": {"type": "string", "minLength": 2, "maxLength": 80},
        "role": {"type": "string", "minLength": 2, "maxLength": 120},
        "expertise_area": {"type": "string", "minLength": 2, "maxLength": 240},
        "conflict_declared": {"type": "boolean"},
        "completed_date": {"type": "string", "format": "date"},
        "study_judgments": {"type": "array", "items": {"$ref": "#/$defs/studyJudgment"}},
        "claim_judgments": {"type": "array", "items": {"$ref": "#/$defs/claimJudgment"}},
        "appraisal_judgments": {"type": "array", "items": {"$ref": "#/$defs/appraisalJudgment"}},
        "abstention_judgment": {"$ref": "#/$defs/abstention"}
      }
    },
    "studyJudgment": {
      "type": "object", "additionalProperties": false,
      "required": ["study_id", "eligible", "counterevidence", "critical"],
      "properties": {"study_id": {"$ref": "#/$defs/id"}, "eligible": {"type": "boolean"}, "counterevidence": {"type": "boolean"}, "critical": {"type": "boolean"}}
    },
    "claimJudgment": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "support_status", "citation_adequate"],
      "properties": {
        "claim_id": {"$ref": "#/$defs/id"},
        "support_status": {"enum": ["supported", "partially_supported", "contradicted", "irrelevant", "insufficient", "not_assessed"]},
        "citation_adequate": {"type": "boolean"}
      }
    },
    "appraisalJudgment": {
      "type": "object", "additionalProperties": false,
      "required": ["field_id", "study_design", "correct"],
      "properties": {"field_id": {"$ref": "#/$defs/id"}, "study_design": {"type": "string", "minLength": 1, "maxLength": 120}, "correct": {"type": "boolean"}}
    },
    "abstention": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "produced", "appropriate"],
      "properties": {"required": {"type": "boolean"}, "produced": {"type": "boolean"}, "appropriate": {"type": "boolean"}}
    },
    "adjudication": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer_count", "study_judgments", "claim_judgments", "appraisal_judgments", "abstention_judgment", "notes"],
      "properties": {
        "status": {"enum": ["pending", "adjudicated"]},
        "reviewer_count": {"type": "integer", "minimum": 2},
        "study_judgments": {"type": "array", "items": {"$ref": "#/$defs/studyJudgment"}},
        "claim_judgments": {"type": "array", "items": {"$ref": "#/$defs/claimJudgment"}},
        "appraisal_judgments": {"type": "array", "items": {"$ref": "#/$defs/appraisalJudgment"}},
        "abstention_judgment": {"$ref": "#/$defs/abstention"},
        "notes": {"type": "string", "maxLength": 5000}
      }
    }
  }
}
