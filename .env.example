APP_ENV=development
DATABASE_URL=
# PostgreSQL connection-establishment and SQLAlchemy pool-acquisition limits.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
FRONTEND_ORIGINS=http://localhost:5173
DEV_AUTH_ENABLED=true
DEV_AUTH_SECRET=replace-with-a-long-random-local-only-secret
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_SECRET=
# Required outside development/test; used only to HMAC-hash rate-limit identities at rest.
RATE_LIMIT_HASH_SECRET=replace-with-a-different-long-random-secret-in-production
MAX_REQUEST_BODY_BYTES=1048576
RATE_LIMIT_USER_PER_MINUTE=120
RATE_LIMIT_IP_PER_MINUTE=300
RATE_LIMIT_USER_JOB_CREATES_PER_HOUR=6
RATE_LIMIT_IP_JOB_CREATES_PER_HOUR=24
RATE_LIMIT_USER_ADVANCES_PER_MINUTE=30
RATE_LIMIT_IP_ADVANCES_PER_MINUTE=120
RATE_LIMIT_DEV_SESSIONS_PER_MINUTE=10
OPENAI_API_KEY=
OPENAI_MODEL_FAST=
OPENAI_MODEL_REASONING=
ALLOW_PAID_LLM_CALLS=false
OPENAI_INPUT_PRICE_PER_MILLION=
OPENAI_OUTPUT_PRICE_PER_MILLION=
LLM_PROVIDER=disabled
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional model-specific control; the bounded research validation runner sets false.
OPENROUTER_REASONING_ENABLED=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
# Sarvam rates checked 2026-10-30 (₹/million tokens, ex GST); setting the provider
# also requires ALLOW_PAID_LLM_CALLS=true and an INR per-job ceiling (maximum ₹5).
SARVAM_INPUT_PRICE_PER_MILLION_INR=15
SARVAM_OUTPUT_PRICE_PER_MILLION_INR=60
SARVAM_MAX_JOB_COST_INR=0
OPENALEX_API_KEY=
# Keep false to use OpenAlex keyless free allowance; true is required before sending a keyed request.
OPENALEX_ALLOW_BILLABLE_CALLS=false
CROSSREF_MAILTO=
MAX_JOB_COST_USD=2.00
MAX_DAILY_MODEL_CALLS=25
MAX_DAILY_MODEL_CALLS_PER_USER=10
# Rights processing is purpose- and jurisdiction-specific. Leave jurisdiction blank
# to keep unlicensed content metadata-only/review-required. This profile is not legal advice.
RIGHTS_USE_MODE=private_research
RIGHTS_JURISDICTION=

